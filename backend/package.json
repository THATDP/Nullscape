{
  "name": "nullscape-server",
  "version": "1.0.0",
  "private": true,
  "description": "Servidor autoritativo multiplayer de NULLSCAPE",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "test:unit": "node --test \"test/worldgen.test.js\" \"test/physics.test.js\" \"test/creatures.test.js\" \"test/puzzles.test.js\" \"test/rooms.test.js\"",
    "test:integration": "node --test \"test/integration.test.js\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.1"
  }
}
